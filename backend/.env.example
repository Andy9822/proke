PORT=48211
MONGO_URL=mongodb://localhost:47117/proke

# Signs the session JWTs.
AUTH_JWT_SECRET=change-me

# --- Session lifetimes ---
# A session is two tokens. The access token is a signed JWT sent on every request; nothing can
# recall it, so it is short. The refresh token is a row in Mongo the browser spends at
# /auth/refresh for a new access token, so it is long and it *can* be recalled - signing out or
# deleting an account deletes the row.
#
# One hour. It is also how long a revoked session, or a deleted account, can still be talked to.
ACCESS_TOKEN_TTL_SECONDS=3600

# Thirty days, and sliding: every refresh pushes it out again. So this is really "how long proke
# may go untouched before it asks GitHub again", not a countdown from logging in.
REFRESH_TOKEN_TTL_MS=2592000000

# Signs the OAuth `state` on the Slack round trip. Separate from the JWT secret on purpose:
# state travels through Slack's logs and the browser's history, and rotating either secret
# should not silently invalidate the other.
#   openssl rand -base64 32
STATE_SIGNING_SECRET=change-me

# Where the frontend is served. OAuth callbacks land on this backend (it is the one with a
# public https URL) and get handed back here, so the browser finishes on the origin holding
# the session.
APP_URL=http://localhost:49173

# --- GitHub App ---
# One app does everything: user login, webhooks, and installation lookups. There is no separate
# OAuth App because an org can block those outright with access restrictions, while a GitHub App
# somebody has installed is already approved.
#
# GH_ rather than GITHUB_ because GitHub reserves the GITHUB_ prefix for Actions secrets and
# refuses to save one using it. Keeping the same names here and in the deploy means the CI
# secret, the container env and this file never drift apart.

GH_APP_ID=
# The URL slug, i.e. the last segment of https://github.com/apps/<slug>
GH_APP_SLUG=

# User-to-server login. From the app's General page - NOT the app id.
GH_APP_CLIENT_ID=
GH_APP_CLIENT_SECRET=

# The .pem GitHub gives you. Either paste it with \n escapes, or base64 the whole file:
#   base64 -i proke.private-key.pem | pbcopy
GH_APP_PRIVATE_KEY=
GH_APP_WEBHOOK_SECRET=

# --- Slack app ---
# One app, installed by each workspace through OAuth. There is no bot token here on purpose:
# tokens are per workspace and arrive when somebody installs it.
#
# Bot scopes: chat:write, im:write. User scope: identity.basic.

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Verifies the Events API requests (Basic Information -> App Credentials).
SLACK_SIGNING_SECRET=

# Where Slack sends people back, and it must match the app's Redirect URL exactly. Slack
# refuses plain http - localhost included - so it points at this backend's public tunnel, which
# then hands the code back to APP_URL. `mprocs` keeps this line in sync with the live tunnel;
# see scripts/tunnels.mjs.
SLACK_REDIRECT_URI=

# Encrypts third-party tokens at rest - the Slack bot token, and every user's GitHub
# user-to-server token. It is the app's one data-at-rest key, and it is not Slack's, which is
# why it is no longer named as if it were.
#
# Not the same thing as STATE_SIGNING_SECRET above. That one signs the Slack OAuth `state` and
# cannot be reversed. This one encrypts, and losing it makes every stored token unreadable.
#
# Any string. 32+ random bytes is the idea:
#   openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- PostHog ---
# Blank turns analytics - and the log copy that ships to PostHog Logs alongside it - off
# entirely, which is what a local run and the e2e suite both want: neither should be adding to
# the numbers or making network calls to do it.
#
# The same project token the frontend uses, so events from both halves land in one project. It
# is a write-only token and is already public in the browser bundle, so there is nothing here a
# leak would expose - but it is still read from the environment rather than committed, because
# which project a deploy writes to should not be a code change.
#
# Unlike every other secret in this file, a missing one does not stop the app booting. Losing
# numbers is not worth refusing to deliver notifications over; the backend logs a warning in
# production instead. See isAnalyticsConfigured in src/shared/configs/env-configs.ts.
POSTHOG_API_KEY=

# EU project. Use https://us.i.posthog.com for a US one; it must match VITE_POSTHOG_HOST.
POSTHOG_HOST=https://eu.i.posthog.com

# --- Inbox warming ---
# How often the inbox of everybody who opened it in the last two days is rebuilt under their
# stored settings, in milliseconds. Each sweep costs one GitHub GraphQL query per such user,
# against that user's own 5,000-an-hour budget - every five minutes is 12 of them.
#
# 0 turns the sweep off entirely without a release, which is also what the e2e suite runs with:
# a timer reaching for GitHub in the background would make every spec's mocks a race.
INBOX_WARM_SWEEP_INTERVAL_MS=300000

# --- Daily digest ---
# How often the sweep looks for somebody whose chosen hour has come, in milliseconds. Not how
# often anybody is messaged: one digest per person per local day is settled by a conditional
# write whatever this is set to, so it only decides how soon after their hour they hear.
#
# A quarter hour is the coarsest that still honours zones offset by half and three-quarter hours.
# 0 turns it off entirely without a release, which is what the e2e suite runs with - and more so
# than the sweep above, because this timer posts to Slack rather than only reading.
DIGEST_SWEEP_INTERVAL_MS=900000
